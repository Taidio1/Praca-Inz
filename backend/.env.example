# Supabase (backend)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sekret JWT (lokalny stack: patrz `supabase status`); pusty => weryfikacja przez JWKS
SUPABASE_JWT_SECRET=

# API
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dane rynkowe
# Darmowy klucz: https://finnhub.io (bez klucza akcje/ETF są pomijane)
FINNHUB_API_KEY=
# Analiza spółek (SEC EDGAR wymaga User-Agent z kontaktem, np. "Opes jan@example.com")
SEC_USER_AGENT=
MARKET_REFRESH_SECONDS=60

# Silnik informacyjny
ENGINE_INTERVAL_SECONDS=900
INGEST_LOOKBACK_HOURS=72
# Opcjonalnie JSON z feedami RSS per rynek; pusty => domyślne (Bankier, stooq, CoinDesk, Cointelegraph, EBC, Fed)
RSS_FEEDS=
# false na serwerze ze wspólnym IPv4 (np. mikr.us), gdzie GDELT stale zwraca HTTP 429
GDELT_ENABLED=true
GDELT_MIN_INTERVAL_SECONDS=6
FINNHUB_NEWS_RPM=30

# Filtr trafności
RELEVANCE_THRESHOLD=0.5
RELEVANCE_WEIGHTS=0.5,0.5
RELEVANCE_BATCH_SIZE=500
EMBEDDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
COSINE_FLOOR=0.83
COSINE_CEILING=0.86

# LLM (bez klucza: profile zapasowe z nazwy i aliasów)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Synteza LLM (twardy limit dzienny kosztu, wyzwalacze)
LLM_DAILY_BUDGET_USD=0.60
SYNTH_IMPORTANT_SCORE=0.85
SYNTH_BATCH_MIN=3
SYNTH_DAILY_HOURS=24
SYNTH_MAX_PER_ASSET_DAY=6
SYNTH_MIN_GAP_MINUTES=30
SYNTH_MAX_ITEMS=10
SYNTH_MAX_PER_CYCLE=10
SYNTH_COST_RESERVE_USD=0.01
