# Zmienne dla docker-compose.yml (skopiuj do .env obok docker-compose.yml).
# Sekrety backendu są osobno, w backend/.env.

# Publiczny adres aplikacji: trafia do frontendu (adres API) i do CORS backendu
PUBLIC_URL=https://opes.tojest.dev

# Port na hoście, na którym słucha frontend (3000 zajmuje jestemkapi-app)
OPES_PORT=3001

# Publiczne klucze Supabase dla przeglądarki (te same co w frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
